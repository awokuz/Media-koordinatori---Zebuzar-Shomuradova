/* ============ NAVBAR LOGO KATTALASHTIRILDI ============ */
.logo img {
  height: 55px;
  width: auto;
  object-fit: contain;
}

/* ============ HERO SECTION KATTALASHTIRILDI ============ */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100px 60px 80px;
  gap: 50px;
  position: relative;
  min-height: 500px;
}

.hero-content { max-width: 50%; }

.hero h1 {
  font-size: 62px;
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 20px;
  background: linear-gradient(135deg, #fff 0%, #c0c4d6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero p {
  font-size: 20px;
  color: #a0a4b8;
  margin-bottom: 35px;
}

.hero-visual {
  width: 50%;
  position: relative;
  height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-img {
  max-width: 520px;
  width: 100%;
  filter: drop-shadow(0 20px 40px rgba(102, 126, 234, 0.5));
}

.glow {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 450px;
  height: 120px;
  background: radial-gradient(ellipse, rgba(102, 126, 234, 0.4), transparent 70%);
  border-radius: 50%;
}

/* ============ RESPONSIVE O'ZGARISHLAR ============ */
@media (max-width: 1024px) {
  .hero { 
    flex-direction: column; 
    padding: 60px 30px; 
    min-height: auto;
  }
  .hero-content { max-width: 100%; text-align: center; }
  .hero-visual { width: 100%; height: 350px; }
  .hero-img { max-width: 380px; }
  .glow { width: 320px; height: 80px; }
}

@media (max-width: 600px) {
  .hero h1 { font-size: 38px; }
  .hero-visual { height: 280px; }
  .hero-img { max-width: 280px; }
  .logo img { height: 45px; }
}
